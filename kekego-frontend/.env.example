# ---------------------------------------------------------------------------
# Rydepus frontend - environment template
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit a file that holds real credentials.
# ---------------------------------------------------------------------------

# Django API ----------------------------------------------------------------
# Base URL of the backend including the /api/v1 prefix.
#
# THIS IS BAKED INTO THE BUNDLE AT BUILD TIME. A production build that is missing
# this value is rejected by vite.config.ts rather than silently shipping a bundle
# that only works on the build machine (127.0.0.1 means the phone on a real device).
#
#   local dev      -> http://127.0.0.1:8000/api/v1
#   LAN / phone    -> http://192.168.x.y:8000/api/v1  (your machine's IP, not localhost)
#   production     -> https://your-api.example.com/api/v1   (must be HTTPS)
VITE_API_BASE_URL=https://rydepus-backend.onrender.com/api/v1

# Google sign-in ------------------------------------------------------------
# OAuth 2.0 **client ID** from Google Cloud Console > APIs & Services > Credentials.
# This is a public identifier and is safe to ship in the bundle. A client secret
# is never needed or wanted here: the backend verifies the returned ID token.
# Leave it empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

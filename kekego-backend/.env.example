# ---------------------------------------------------------------------------
# Campus Keke backend - environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS (list of allowed browser origins) ---------------------------------
# REQUIRED in production. The API sends NO Access-Control-Allow-Origin header
# unless the calling site's origin appears here, and the browser then blocks the
# response so Sign In fails with a network error even though the API is healthy.
# Comma-separated, no trailing slashes, scheme + host + port only.
# Must list the FRONTEND's origin(s), not the API's own.
#   DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#   DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS takes the same values and is needed for admin/session use.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# Database ---------------------------------------------------------------
# Option A: PostgreSQL (recommended for real development). Set the
# DATABASE_* variables below and leave DATABASE_URL empty.
# Option B: easy local run without Postgres - leave DATABASE_HOST empty and
# the development settings automatically fall back to a SQLite file.
DATABASE_URL=
DATABASE_NAME=campus_keke
DATABASE_USER=campus_keke
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT --------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Passwords ---------------------------------------------------------------
# Minimum length accepted at registration and password change. Keep in sync
# with PASSWORD_MIN_LENGTH in the frontend.
DJANGO_PASSWORD_MIN_LENGTH=10

# Google sign-in ----------------------------------------------------------
# OAuth 2.0 **client ID** (not a secret) from Google Cloud Console >
# APIs & Services > Credentials. Must match VITE_GOOGLE_CLIENT_ID in the
# frontend. When empty, the Google identity endpoint reports that Google
# sign-in is not configured.
GOOGLE_OAUTH_CLIENT_ID=
# Optional. Restrict Google sign-up to one email domain, e.g. campus.edu.ng.
# Leave empty to allow any Google account.
GOOGLE_ALLOWED_EMAIL_DOMAIN=

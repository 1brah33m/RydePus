# ---------------------------------------------------------------------------
# Campus Keke / Rydepus backend - environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS (list of allowed browser origins). Must be explicit in production.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# API docs (schema/Swagger/Redoc) - keep False outside of development.
# DJANGO_ENABLE_API_DOCS=False

# Admin is served at this path. In production use a non-guessable value.
DJANGO_ADMIN_URL=admin

# Database ---------------------------------------------------------------
# Option A: PostgreSQL (recommended for real development). Set the
# DATABASE_* variables below and leave DATABASE_URL empty.
# Option B: easy local run without Postgres - leave DATABASE_HOST empty and
# the development settings automatically fall back to a SQLite file.
DATABASE_URL=
DATABASE_NAME=campus_keke
DATABASE_USER=campus_keke
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# DATABASE_CONN_MAX_AGE=60

# Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ACKS_LATE=True
# CELERY_WORKER_PREFETCH_MULTIPLIER=4
# CELERY_TASK_TIME_LIMIT=300
# REDIS_REQUIRED=True   # production readiness treats Redis as critical

# JWT --------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Payments ---------------------------------------------------------------
# manual (placeholder, dev/tests only) or paystack (production).
# Production refuses to start with PAYMENT_PROVIDER=paystack unless the keys
# below are set.
PAYMENT_PROVIDER=manual
# PAYSTACK_SECRET_KEY=pk_test_...
# PAYSTACK_WEBHOOK_SECRET=<paystack webhook secret>

# Server-side price for a single group-buyout seat. Buyout amounts are never
# taken from the client. Leave at 0 to disable buyouts until configured.
GROUP_SEAT_FARE=0

# Monitoring / alerting --------------------------------------------------
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts   # receives {alert:{...}}
# ALERT_EMAILS=ops@example.com,oncall@example.com
# RYDEPUS_RELEASE=v1.0.0

# Backups ----------------------------------------------------------------
# BACKUP_DIR=backups

# HTTPS / security (production) ------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=15552000
# DJANGO_SECURE_REFERRER_POLICY=same-origin
# DJANGO_SESSION_COOKIE_SAMESITE=Lax
# DJANGO_CSRF_COOKIE_SAMESITE=Lax
# ---------------------------------------------------------------------------
# Campus Keke backend - environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS (list of allowed browser origins)
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database ---------------------------------------------------------------
# Option A: PostgreSQL (recommended for real development). Set the
# DATABASE_* variables below and leave DATABASE_URL empty.
# Option B: easy local run without Postgres - leave DATABASE_HOST empty and
# the development settings automatically fall back to a SQLite file.
DATABASE_URL=
DATABASE_NAME=campus_keke
DATABASE_USER=campus_keke
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT --------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7